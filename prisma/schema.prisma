generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  id              Int      @id @default(autoincrement())
  proName         String
  proPrice        Float
  proQuantity     Int
  proDescription  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
